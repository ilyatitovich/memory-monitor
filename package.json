{
  "name": "memory-monitor",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "description": "A library for monitoring memory usage and detecting memory leaks.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilyatitovich/memory-monitor.git"
  },
  "homepage": "https://github.com/ilyatitovich/memory-monitor",
  "bugs": {
    "url": "https://github.com/ilyatitovich/memory-monitor/issues"
  },
  "keywords": [
    "memory",
    "monitor",
    "leak",
    "detection",
    "memory-monitor"
  ],
  "author": "Ilya Titov",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
    "test": "c8 --100 bnt",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "prepack": "pnpm run build && pnpm test"
  },
  "c8": {
    "extension": [
      ".ts"
    ],
    "include": [
      "index.ts"
    ],
    "exclude": [
      "tests/**",
      "dist/**"
    ],
    "reporter": [
      "text",
      "html"
    ],
    "check-coverage": true,
    "lines": 100,
    "functions": 100,
    "branches": 100,
    "statements": 100
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "better-node-test": "^0.8.4",
    "c8": "^10.1.3",
    "typescript": "^7.0.2"
  }
}
